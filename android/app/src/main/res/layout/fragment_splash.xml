<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <ImageView
        android:id="@+id/splash_art"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.22"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_splash"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/splash_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/scrim_splash_art"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/splash_feather_one"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:alpha="0.85"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/sprite_feather"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.14"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.17" />

    <ImageView
        android:id="@+id/splash_feather_two"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:alpha="0.7"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/sprite_feather"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.88"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.26" />

    <ImageView
        android:id="@+id/splash_feather_three"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:alpha="0.6"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/sprite_feather"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.82"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.74" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/splash_guide_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.14" />

    <ImageView
        android:id="@+id/splash_hen"
        android:layout_width="@dimen/splash_hen"
        android:layout_height="@dimen/splash_hen"
        android:contentDescription="@string/cd_hen"
        android:scaleType="fitCenter"
        android:src="@drawable/sprite_hen_runner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_guide_top" />

    <TextView
        android:id="@+id/splash_title_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_l"
        android:shadowColor="@color/white_glass"
        android:shadowDx="0"
        android:shadowDy="-1"
        android:shadowRadius="2"
        android:text="@string/splash_title_top"
        android:textAppearance="@style/TextAppearance.App.Hero"
        android:textColor="@color/ink"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_hen" />

    <TextView
        android:id="@+id/splash_title_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.16"
        android:shadowColor="@color/clay_shadow"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="4"
        android:text="@string/splash_title_bottom"
        android:textColor="@color/white_soft"
        android:textSize="34sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_title_top" />

    <View
        android:id="@+id/splash_rule"
        android:layout_width="86dp"
        android:layout_height="4dp"
        android:layout_marginTop="@dimen/gap_m"
        android:background="@drawable/clay_pill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_title_bottom" />

    <TextView
        android:id="@+id/splash_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_m"
        android:alpha="0.86"
        android:text="@string/splash_tagline"
        android:textAppearance="@style/TextAppearance.App.Label"
        android:textColor="@color/on_pumpkin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_rule" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/splash_progress"
        android:layout_width="@dimen/progress_splash"
        android:layout_height="@dimen/progress_splash"
        android:indeterminate="true"
        app:indicatorColor="@color/white_soft"
        app:indicatorSize="@dimen/progress_splash"
        app:layout_constraintBottom_toTopOf="@+id/splash_status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:trackColor="@color/white_track"
        app:trackThickness="@dimen/progress_thickness" />

    <TextView
        android:id="@+id/splash_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:layout_marginBottom="@dimen/gap_l"
        android:text="@string/splash_status_one"
        android:textAppearance="@style/TextAppearance.App.Label"
        android:textColor="@color/on_pumpkin"
        app:layout_constraintBottom_toTopOf="@+id/splash_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/splash_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_xl"
        android:alpha="0.62"
        android:text="@string/splash_footer"
        android:textAppearance="@style/TextAppearance.App.Label"
        android:textColor="@color/on_pumpkin"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
