<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_canvas">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/menu_art_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.66" />

    <ImageView
        android:id="@+id/menu_art"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_menu"
        app:layout_constraintBottom_toTopOf="@id/menu_art_guide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/menu_art_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/scrim_menu_art"
        app:layout_constraintBottom_toBottomOf="@id/menu_art"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/menu_art" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/menu_settings"
        style="@style/Widget.App.IconButton"
        android:layout_width="@dimen/icon_button"
        android:layout_height="@dimen/icon_button"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginTop="@dimen/status_pad"
        android:contentDescription="@string/cd_settings"
        app:backgroundTint="@color/surface_sheet"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_cog"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/menu_feather_badge"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/icon_button"
        android:layout_marginTop="@dimen/status_pad"
        android:layout_marginEnd="@dimen/gutter"
        android:background="@drawable/clay_pill"
        android:contentDescription="@string/cd_feather_badge"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gap_s"
        android:paddingEnd="@dimen/gap_m"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/menu_feather_icon"
            android:layout_width="@dimen/sprite_feather_badge"
            android:layout_height="@dimen/sprite_feather_badge"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/sprite_feather" />

        <TextView
            android:id="@+id/menu_feather_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_xs"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.App.Numeric"
            android:textSize="18sp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/menu_hen"
        android:layout_width="@dimen/menu_hen"
        android:layout_height="@dimen/menu_hen"
        android:layout_marginBottom="18dp"
        android:contentDescription="@string/cd_hen"
        android:scaleType="fitCenter"
        android:src="@drawable/sprite_hen_runner"
        app:layout_constraintBottom_toBottomOf="@id/menu_art"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/menu_sheet"
        style="@style/Widget.App.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_sheet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Sheet">

        <LinearLayout
            android:id="@+id/menu_sheet_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter_wide"
            android:paddingTop="@dimen/gap_l"
            android:paddingEnd="@dimen/gutter_wide"
            android:paddingBottom="@dimen/gap_l">

            <TextView
                android:id="@+id/menu_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/menu_title"
                android:textAppearance="@style/TextAppearance.App.Title" />

            <TextView
                android:id="@+id/menu_tagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_xs"
                android:gravity="center"
                android:text="@string/menu_tagline"
                android:textAppearance="@style/TextAppearance.App.Label" />

            <LinearLayout
                android:id="@+id/menu_stats_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.poultrypathsprint.arcade.core.ui.StatCardView
                    android:id="@+id/menu_stat_best"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/gap_xs"
                    android:layout_weight="1"
                    app:appAccent="@color/pumpkin"
                    app:appLabel="@string/label_best_metres" />

                <com.poultrypathsprint.arcade.core.ui.StatCardView
                    android:id="@+id/menu_stat_feathers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_xs"
                    android:layout_weight="1"
                    app:appAccent="@color/corn_deep"
                    app:appLabel="@string/label_feathers" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/menu_play_wrap"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_primary_h"
                android:layout_marginTop="@dimen/gap_m"
                android:background="@drawable/clay_button_primary">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menu_play"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/btn_face_inset"
                    android:text="@string/btn_play"
                    app:icon="@drawable/ic_boot" />

            </FrameLayout>

            <LinearLayout
                android:id="@+id/menu_secondary_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_s"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menu_outfits"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_secondary_h"
                    android:layout_marginEnd="@dimen/gap_xs"
                    android:layout_weight="1"
                    android:text="@string/btn_outfit_coop" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menu_how_to"
                    style="@style/Widget.App.Button.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_secondary_h"
                    android:layout_marginStart="@dimen/gap_xs"
                    android:layout_weight="1"
                    android:text="@string/btn_how_to" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
